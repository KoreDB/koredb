{
  "name": "@koredb/koredb",
  "version": "0.0.1",
  "description": "An in-process property graph database management system built for query speed and scalability.",
  "main": "index.js",
  "module": "./index.mjs",
  "types": "./koredb.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.mjs",
      "types": "./koredb.d.ts"
    },
    "./package.json": "./package.json"
  },
  "type": "commonjs",
  "binary": {
    "napi_versions": [
      6
    ]
  },
  "engines": {
    "node": ">=16"
  },
  "homepage": "https://koredb.github.io/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KoreDB/koredb.git",
    "directory": "tools/nodejs_api"
  },
  "bugs": {
    "url": "https://github.com/KoreDB/koredb/issues"
  },
  "scripts": {
    "test": "mocha test --timeout 20000",
    "bench": "node --expose-gc bench/query-bench.js",
    "bench:gen": "tsc -p bench/tsconfig.json && node bench/dist/gen-bench-db.js",
    "clean": "node clean.js",
    "clean-all": "node clean.js all",
    "build": "node build.js",
    "test:electron": "npm --prefix test/electron run test"
  },
  "author": "KoreDB Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "chai": "^4.4.1",
    "mocha": "^10.4.0",
    "tmp": "^0.2.3",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@koredb/koredb-win32-x64": "file:dist/koredb-koredb-win32-x64-0.11.3.tgz",
    "cmake-js": "^7.3.0",
    "koredb": "file:dist/koredb-0.11.3.tgz",
    "node-addon-api": "^6.0.0"
  }
}
