-DATASET CSV empty

--

-CASE SpillOrderByBasic
# Exercises the out-of-core ORDER BY path (spill_order_by). v1 is eligible for fixed-width keys and
# flat payloads; the ordered output must match the in-memory sort. Budget 0 derives the whole buffer
# pool so this small input stays in one run, verifying the append -> finalize -> merge -> scan wiring
# end to end. Larger, actually-spilling cases are covered by buffer_manager_test SpillOrderByDifferential.
-STATEMENT CALL threads=1;
---- ok
-STATEMENT CALL spill_order_by=true;
---- ok
-STATEMENT CREATE NODE TABLE t(id INT64, a INT64, us STRING, PRIMARY KEY(id));
---- ok
-STATEMENT UNWIND range(0, 5) AS i CREATE (:t {id: i, a: (i * 3) % 5, us: 'commonprefix' + cast(i AS STRING)});
---- ok
-STATEMENT MATCH (n:t) RETURN n.id, n.a ORDER BY n.a ASC, n.id ASC;
-CHECK_ORDER
---- 6
0|0
5|0
2|1
4|2
1|3
3|4
-STATEMENT MATCH (n:t) RETURN n.id, n.a ORDER BY n.a DESC, n.id DESC;
-CHECK_ORDER
---- 6
3|4
1|3
4|2
2|1
5|0
0|0
# Long STRING key (13 chars, shared 12-char prefix): the encoded 12-byte prefix ties, so the order is
# decided by the full string.
-STATEMENT MATCH (n:t) RETURN n.id, n.us ORDER BY n.us ASC;
-CHECK_ORDER
---- 6
0|commonprefix0
1|commonprefix1
2|commonprefix2
3|commonprefix3
4|commonprefix4
5|commonprefix5
-STATEMENT MATCH (n:t) RETURN n.id, n.us ORDER BY n.us DESC;
-CHECK_ORDER
---- 6
5|commonprefix5
4|commonprefix4
3|commonprefix3
2|commonprefix2
1|commonprefix1
0|commonprefix0
