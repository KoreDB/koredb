-DATASET CSV empty

--

-CASE SpillOrderByBasic
# Exercises the out-of-core ORDER BY path (spill_order_by). v1 is eligible for fixed-width keys and
# flat payloads; the ordered output must match the in-memory sort. Budget 0 derives the whole buffer
# pool so this small input stays in one run, verifying the append -> finalize -> merge -> scan wiring
# end to end. Larger, actually-spilling cases are covered by buffer_manager_test SpillOrderByDifferential.
-STATEMENT CALL threads=1;
---- ok
-STATEMENT CALL spill_order_by=true;
---- ok
-STATEMENT CREATE NODE TABLE t(id INT64, a INT64, us STRING, PRIMARY KEY(id));
---- ok
-STATEMENT UNWIND range(0, 5) AS i CREATE (:t {id: i, a: (i * 3) % 5, us: 'commonprefix' + cast(i AS STRING)});
---- ok
-STATEMENT MATCH (n:t) RETURN n.id, n.a ORDER BY n.a ASC, n.id ASC;
-CHECK_ORDER
---- 6
0|0
5|0
2|1
4|2
1|3
3|4
-STATEMENT MATCH (n:t) RETURN n.id, n.a ORDER BY n.a DESC, n.id DESC;
-CHECK_ORDER
---- 6
3|4
1|3
4|2
2|1
5|0
0|0
# Long STRING key (13 chars, shared 12-char prefix): the encoded 12-byte prefix ties, so the order is
# decided by the full string.
-STATEMENT MATCH (n:t) RETURN n.id, n.us ORDER BY n.us ASC;
-CHECK_ORDER
---- 6
0|commonprefix0
1|commonprefix1
2|commonprefix2
3|commonprefix3
4|commonprefix4
5|commonprefix5
-STATEMENT MATCH (n:t) RETURN n.id, n.us ORDER BY n.us DESC;
-CHECK_ORDER
---- 6
5|commonprefix5
4|commonprefix4
3|commonprefix3
2|commonprefix2
1|commonprefix1
0|commonprefix0
# Multi-threaded external sort (threads>1): run generation fans out across threads and the single
# scan thread k-way merges across all threads' runs. The total order must be identical.
-STATEMENT CALL threads=4;
---- ok
-STATEMENT MATCH (n:t) RETURN n.id, n.a ORDER BY n.a ASC, n.id ASC;
-CHECK_ORDER
---- 6
0|0
5|0
2|1
4|2
1|3
3|4
# Multi-group input: a comma cross-product puts n and m in different factorization groups, so the
# ORDER BY keys span multiple data chunks; the external sort emits these tuple-at-a-time in the
# same order as the in-memory sort.
-STATEMENT CREATE NODE TABLE u(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT UNWIND range(0, 2) AS i CREATE (:u {id: i});
---- ok
-STATEMENT MATCH (n:t), (m:u) RETURN n.id, m.id ORDER BY n.id ASC, m.id DESC;
-CHECK_ORDER
---- 18
0|2
0|1
0|0
1|2
1|1
1|0
2|2
2|1
2|0
3|2
3|1
3|0
4|2
4|1
4|0
5|2
5|1
5|0
